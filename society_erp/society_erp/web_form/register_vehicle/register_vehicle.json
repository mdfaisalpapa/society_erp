 "client_script": "frappe.web_form.after_load = () => {\n    // 1. Auto-fill Flat (Will ONLY populate for actual logged-in residents)\n    frappe.call({\n        method: 'society_erp.resident_portal.get_verified_owner_records',\n        callback: function(r) {\n            if (r.message && r.message.length > 0) {\n                frappe.web_form.set_value('flat', r.message[0].flat);\n            }\n        }\n    });\n\n    // 2. Filter 'Make' based on 'Vehicle Type' natively\n    frappe.web_form.fields_dict['make'].get_query = function() {\n        let v_type = frappe.web_form.get_value(\"vehicle_type\");\n        return {\n            filters: { \"vehicle_type\": v_type }\n        };\n    };\n\n    // 3. Filter 'Model' based on selected 'Make' natively\n    frappe.web_form.fields_dict['model'].get_query = function() {\n        let v_make = frappe.web_form.get_value(\"make\");\n        return {\n            filters: { \"make\": v_make }\n        };\n    };\n\n    // 4. Clear dependent fields automatically on change\n    frappe.web_form.on('vehicle_type', (field, value) => {\n        frappe.web_form.set_value('make', '');\n        frappe.web_form.set_value('model', '');\n    });\n\n    frappe.web_form.on('make', (field, value) => {\n        frappe.web_form.set_value('model', '');\n    });\n};",
